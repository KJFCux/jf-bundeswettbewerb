<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">

    <!-- Shared values -->
    <CornerRadius x:Key="Modern.CornerRadius.Small">4</CornerRadius>
    <CornerRadius x:Key="Modern.CornerRadius.Medium">6</CornerRadius>
    <CornerRadius x:Key="Modern.CornerRadius.Large">10</CornerRadius>
    <sys:Double x:Key="Modern.Input.MinHeight">32</sys:Double>

    <!-- Buttons -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MahApps.Styles.Button}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="Modern.Button.Accent" BasedOn="{StaticResource MahApps.Styles.Button.Square.Accent}">
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.25"
                                  Color="{DynamicResource MahApps.Colors.Accent}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton -->
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource MahApps.Styles.ToggleButton}">
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="8" />
    </Style>

    <!-- TextBox -->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="MinHeight" Value="{StaticResource Modern.Input.MinHeight}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="2" />
    </Style>

    <!-- PasswordBox -->
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
        <Setter Property="MinHeight" Value="{StaticResource Modern.Input.MinHeight}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="2" />
    </Style>

    <!-- ComboBox -->
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="MinHeight" Value="{StaticResource Modern.Input.MinHeight}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="2" />
    </Style>

    <!-- DatePicker -->
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
        <Setter Property="MinHeight" Value="{StaticResource Modern.Input.MinHeight}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="2" />
    </Style>

    <!-- NumericUpDown -->
    <Style TargetType="{x:Type mah:NumericUpDown}" BasedOn="{StaticResource MahApps.Styles.NumericUpDown}">
        <Setter Property="MinHeight" Value="{StaticResource Modern.Input.MinHeight}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="6" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="2" />
    </Style>

<!-- CheckBox / RadioButton -->
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,0,0,0" />
    </Style>
    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,0,0,0" />
    </Style>

    <!-- TabControl / TabItem  -->
    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource MahApps.Styles.TabItem}">
        <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="18" />
        <Setter Property="mah:HeaderedControlHelper.HeaderFontWeight" Value="SemiBold" />
        <Setter Property="mah:HeaderedControlHelper.HeaderMargin" Value="14,8" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="8,8,0,0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                <Setter Property="mah:HeaderedControlHelper.HeaderFontWeight" Value="Bold" />
                <Setter Property="Panel.ZIndex" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent3}" />
                <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource MahApps.Styles.TabControl}">
        <Setter Property="Padding" Value="0,0,4,0" />
    </Style>

    <!-- DataGrid -->
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource MahApps.Brushes.Gray10}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeight" Value="32" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.AccentBase}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Card-Container -->
    <Style TargetType="{x:Type Border}" x:Key="Modern.Card">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14"
                                  ShadowDepth="0"
                                  Opacity="0.12"
                                  Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MetroWindow -->
    <Style TargetType="{x:Type mah:MetroWindow}" BasedOn="{StaticResource MahApps.Styles.MetroWindow}">
        <Setter Property="TitleCharacterCasing" Value="Normal" />
        <Setter Property="ShowIconOnTitleBar" Value="True" />
        <Setter Property="WindowTitleBrush" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="NonActiveWindowTitleBrush" Value="{DynamicResource MahApps.Brushes.Accent2}" />
    </Style>

</ResourceDictionary>
