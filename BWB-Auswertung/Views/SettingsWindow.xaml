<Window x:Class="BWB_Auswertung.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BWB_Auswertung.Views"
        xmlns:my="clr-namespace:BWB_Auswertung.Models"
        xmlns:svc="clr-namespace:BWB_Auswertung.Services"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Einstellungen"
        Height="1020"
        Width="2020"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged">
    <Window.LayoutTransform>
        <ScaleTransform ScaleX="{Binding ScaleFactorSettings}"
                        ScaleY="{Binding ScaleFactorSettings}" />
    </Window.LayoutTransform>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ScaleFactorSettings}"
                            ScaleY="{Binding ScaleFactorSettings}" />
        </Grid.LayoutTransform>
        <TabControl>
            <TabItem Header="Organisation">
                <DockPanel Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                           x:Name="EinstellungenGrid">
                    <Button DockPanel.Dock="Bottom"
                            Content="Speichern und Schließen"
                            ToolTip="Speichere alle Änderungen"
                            Click="SaveAndClose_Click"
                            Margin="10,10,10,10"
                            HorizontalAlignment="Right">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Center"
                                                                Kind="ContentSave" />
                                    <TextBlock Margin="4 0 0 0"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Grid.Row="0"
                                Grid.RowSpan="2">
                        <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Column="0"
                                        Grid.Row="0">
                                <Label Content="Titel der Veranstaltung:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Ort der Veranstaltung:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Veranstaltungsdatum:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Veranstaltungsleitung:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Logo Pfad:"
                                       ToolTip="Ein ausgewähltes Logo wird auf exportierten Dokumenten und der Urkunde angezeigt. Standard ist das Wappen der DJF"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Namen:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Funktionen:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Unterschrift Links:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Unterschrift Rechts:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                                <Label Content="Art:"
                                       HorizontalAlignment="Right"
                                       Margin="10,10,0,10"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Height="40"
                                       FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Grid.Row="0">
                                <TextBox TextWrapping="Wrap"
                                         Text="{Binding Einstellungen.Veranstaltungstitel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         Margin="0,10,10,10"
                                         Height="40"
                                         MinWidth="400"
                                         MaxWidth="800"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left" />
                                <TextBox TextWrapping="Wrap"
                                         Text="{Binding Einstellungen.Veranstaltungsort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         Margin="0,10,10,10"
                                         Height="40"
                                         MinWidth="400"
                                         MaxWidth="800"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left" />
                                <DatePicker VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            FontSize="16"
                                            MinWidth="400"
                                            Height="40"
                                            MaxWidth="800"
                                            Margin="0,10,10,10"
                                            SelectedDate="{Binding Einstellungen.Veranstaltungsdatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,TargetNullValue={x:Static System:DateTime.Now}}" />
                                <TextBox TextWrapping="Wrap"
                                         Text="{Binding Einstellungen.Veranstaltungsleitung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         Margin="0,10,10,10"
                                         Height="40"
                                         MinWidth="400"
                                         MaxWidth="800"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextWrapping="Wrap"
                                             ToolTip="Ein ausgewähltes Logo wird auf exportierten Dokumenten und der Urkunde angezeigt. Standard ist das Wappen der DJF"
                                             Text="{Binding Einstellungen.Logopfad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             x:Name="SelectedLogoPathTextBox"
                                             FontSize="16"
                                             Margin="0,10,0,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                    <Button Content="Logo Importieren"
                                            ToolTip="Ein ausgewähltes Logo wird auf exportierten Dokumenten und der Urkunde angezeigt. Standard ist das Wappen der DJF"
                                            Click="SelectLogoButton_Click"
                                            Margin="10,10,10,10">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Width="22"
                                                                                Height="22"
                                                                                VerticalAlignment="Center"
                                                                                Kind="Upload" />
                                                    <TextBlock Margin="4 0 0 0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Namelinks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             Margin="0,10,10,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Namerechts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             Margin="0,10,10,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Funktionlinks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             Margin="0,10,10,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Funktionrechts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             Margin="0,10,10,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Unterschriftlinks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             Margin="0,10,0,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             x:Name="SelectedUnterschriftlinksPathTextBox"
                                             HorizontalAlignment="Left" />
                                    <Button Content="Unterschrift Importieren"
                                            Click="SelectUnterschriftlinksButton_Click"
                                            Margin="10,10,10,10">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Width="22"
                                                                                Height="22"
                                                                                VerticalAlignment="Center"
                                                                                Kind="Upload" />
                                                    <TextBlock Margin="4 0 0 0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox TextWrapping="Wrap"
                                             Text="{Binding Einstellungen.Unterschriftrechts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="16"
                                             x:Name="SelectedUnterschriftrechtsPathTextBox"
                                             Margin="0,10,0,10"
                                             Height="40"
                                             MinWidth="200"
                                             MaxWidth="800"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left" />
                                    <Button Content="Unterschrift Importieren"
                                            Click="SelectUnterschriftrechtsButton_Click"
                                            Margin="10,10,10,10">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Width="22"
                                                                                Height="22"
                                                                                VerticalAlignment="Center"
                                                                                Kind="Upload" />
                                                    <TextBlock Margin="4 0 0 0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>

                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox HorizontalAlignment="Left"
                                              Margin="0,10,0,10"
                                              VerticalAlignment="Center"
                                              MinWidth="200"
                                              MaxWidth="800"
                                                FontSize="20"
                                              ItemsSource="{Binding Source={my:Enumeration {x:Type my:Art}}}"
                                              DisplayMemberPath="Description"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Einstellungen.Art}" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>


                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>


            <TabItem Header="Server">
                <DockPanel Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                    <Button DockPanel.Dock="Bottom"
                            Content="Speichern und Schließen"
                            ToolTip="Speichere alle Änderungen"
                            Click="SaveAndClose_Click"
                            Margin="10,10,10,10"
                            HorizontalAlignment="Right">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Center"
                                                                Kind="ContentSave" />
                                    <TextBlock Margin="4 0 0 0"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center">
                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="600"
                                Margin="20,0,20,0">

                        <Label Content="SFTP Daten Verwalten"
                               HorizontalAlignment="Center"
                               Margin="10,10,10,10"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Top" />
                        <Label Content="Server"
                               ToolTip="Hostname des Servers"
                               HorizontalAlignment="Center"
                               Margin="10,10,10,5"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold" />
                        <TextBox TextWrapping="Wrap"
                                 Text="{Binding Einstellungen.Hostname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Hostname des Servers"
                                 FontSize="16"
                                 Margin="10,5,10,10"
                                 Height="34"
                                 TextChanged="TextBox_TextChanged" />
                        <Label Content="Pfad"
                               ToolTip="Pfad zu den Gruppendaten"
                               HorizontalAlignment="Center"
                               Margin="10,10,10,5"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold" />
                        <TextBox TextWrapping="Wrap"
                                 Text="{Binding Einstellungen.Pfad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pfad zu den Gruppendaten"
                                 FontSize="16"
                                 Margin="10,5,10,10"
                                 Height="34"
                                 VerticalAlignment="Center" />
                        <Label Content="Benutzername"
                               ToolTip="Benutzername zum Verbinden mit dem Server"
                               HorizontalAlignment="Center"
                               Margin="10,10,10,5"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold" />
                        <TextBox TextWrapping="Wrap"
                                 Text="{Binding Einstellungen.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Benutzername zum Verbinden mit dem Server"
                                 FontSize="16"
                                 Margin="10,5,10,10"
                                 Height="34"
                                 VerticalAlignment="Center" />

                        <Label Content="Password"
                               ToolTip="Password zum Verbinden mit dem Server"
                               HorizontalAlignment="Center"
                               Margin="10,10,10,5"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold" />
                        <PasswordBox x:Name="SftpPasswordBox"
                                     ToolTip="Password zum Verbinden mit dem Server"
                                     FontSize="16"
                                     Margin="10,5,10,10"
                                     Height="34"
                                     VerticalAlignment="Center"
                                     Loaded="SftpPasswordBox_Loaded"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                        <Button Content="Teste Verbindung"
                                ToolTip="Verbinde mit dem FTP Server und teste die Verbindung"
                                Click="TesteVerbindung_Click"
                                x:Name="TesteVerbindung_Button"
                                Margin="10,20,10,10">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="22"
                                                                    Height="22"
                                                                    VerticalAlignment="Center"
                                                                    Kind="ServerNetwork" />
                                        <TextBlock Margin="4 0 0 0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>


            <TabItem Header="Startzeiten">
                <DockPanel Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                    <Button DockPanel.Dock="Bottom"
                            Content="Speichern und Schließen"
                            ToolTip="Speichere alle Änderungen"
                            Click="SaveAndClose_Click"
                            Margin="10,10,10,10"
                            HorizontalAlignment="Right">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Center"
                                                                Kind="ContentSave" />
                                    <TextBlock Margin="4 0 0 0"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Center">
                        <StackPanel Margin="20"
                                    HorizontalAlignment="Center">
                            <Label Content="Automatische Startzeitenvergabe"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,10"
                                   FontSize="26"
                                   FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="14"
                                       Margin="0,0,0,20"
                                       MaxWidth="900"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Text="Bereits manuell eingetragene Startzeiten und Bahnen bleiben erhalten. Gruppen einer Feuerwehr (Doppelstarter) werden zwischen A- und B-Teil mit dem konfigurierten Mindestabstand eingeplant." />

                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- A-Teil -->
                                <StackPanel Grid.Column="0">
                                    <Label Content="A-Teil"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,10,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Content="Anzahl Bahnen:"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:NumericUpDown Grid.Row="0" Grid.Column="1"
                                                           Minimum="1"
                                                           Maximum="20"
                                                           FontSize="16"
                                                           Margin="0,5,0,5"
                                                           Value="{Binding Einstellungen.AnzahlBahnenATeil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Content="Startabstand (Min):"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:NumericUpDown Grid.Row="1" Grid.Column="1"
                                                           Minimum="1"
                                                           Maximum="120"
                                                           FontSize="16"
                                                           Margin="0,5,0,5"
                                                           Value="{Binding Einstellungen.StartintervallATeilMinuten, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Content="Erste Startzeit:"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:TimePicker Grid.Row="2" Grid.Column="1"
                                                        FontSize="16"
                                                        Margin="0,5,0,5"
                                                        SelectedDateTime="{Binding Einstellungen.StartBeginnATeil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <!-- B-Teil -->
                                <StackPanel Grid.Column="2">
                                    <Label Content="B-Teil"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,10,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Content="Anzahl Bahnen:"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:NumericUpDown Grid.Row="0" Grid.Column="1"
                                                           Minimum="1"
                                                           Maximum="20"
                                                           FontSize="16"
                                                           Margin="0,5,0,5"
                                                           Value="{Binding Einstellungen.AnzahlBahnenBTeil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Content="Startabstand (Min):"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:NumericUpDown Grid.Row="1" Grid.Column="1"
                                                           Minimum="1"
                                                           Maximum="120"
                                                           FontSize="16"
                                                           Margin="0,5,0,5"
                                                           Value="{Binding Einstellungen.StartintervallBTeilMinuten, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Label Grid.Row="2" Grid.Column="0"
                                               Content="Erste Startzeit:"
                                               FontSize="16"
                                               VerticalAlignment="Center" />
                                        <mah:TimePicker Grid.Row="2" Grid.Column="1"
                                                        FontSize="16"
                                                        Margin="0,5,0,5"
                                                        SelectedDateTime="{Binding Einstellungen.StartBeginnBTeil, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Margin="0,20,0,20"
                                       HorizontalAlignment="Center"
                                       Width="500"
                                       Fill="{DynamicResource MahApps.Brushes.AccentBase}"
                                       Height="2" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                                <Label Content="Reihenfolge:"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                                <ComboBox x:Name="ReihenfolgeComboBox"
                                          MinWidth="300"
                                          FontSize="16"
                                          ItemsSource="{Binding Source={my:Enumeration {x:Type svc:AutoStartReihenfolge}}}"
                                          DisplayMemberPath="Description"
                                          SelectedValuePath="Value"
                                          SelectedIndex="0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                                <Label Content="Mindestabstand A↔B (Min):"
                                       ToolTip="Mindestabstand zwischen A- und B-Startzeit derselben Gruppe sowie zwischen Gruppen derselben Feuerwehr (Doppelstarter)."
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                                <mah:NumericUpDown Minimum="0"
                                                   Maximum="240"
                                                   MinWidth="120"
                                                   FontSize="16"
                                                   Value="{Binding Einstellungen.MinAbstandCrossTeilMinuten, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                                <Label Content="Mittagspause ab:"
                                       ToolTip="In diesem Zeitraum werden bei der automatischen Vergabe keine Startzeiten verteilt. Dauer 0 = keine Pause."
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                                <mah:TimePicker MinWidth="120"
                                                FontSize="16"
                                                SelectedDateTime="{Binding Einstellungen.MittagspauseStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Content="Dauer (Min):"
                                       ToolTip="Dauer der Mittagspause in Minuten. 0 = keine Pause."
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="20,0,10,0" />
                                <mah:NumericUpDown Minimum="0"
                                                   Maximum="240"
                                                   MinWidth="120"
                                                   FontSize="16"
                                                   Value="{Binding Einstellungen.MittagspauseDauerMinuten, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,10">
                                <Button Content="Startzeiten automatisch vergeben"
                                        ToolTip="Vergibt für alle Gruppen ohne Startzeit automatisch eine Startzeit und Bahn. Manuell gesetzte Werte bleiben erhalten."
                                        Click="AutoStartzeiten_Click"
                                        Margin="0,0,10,0">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Width="22"
                                                                            Height="22"
                                                                            VerticalAlignment="Center"
                                                                            Kind="ClockOutline" />
                                                <TextBlock Margin="6 0 0 0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                                <Button Content="Alle Startzeiten löschen"
                                        ToolTip="Setzt bei allen Gruppen die Startzeiten und Wettbewerbsbahnen für A- und B-Teil zurück."
                                        Click="StartzeitenLoeschen_Click"
                                        Margin="10,0,0,0">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconMaterial Width="22"
                                                                            Height="22"
                                                                            VerticalAlignment="Center"
                                                                            Kind="TrashCanOutline" />
                                                <TextBlock Margin="6 0 0 0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>


            <TabItem Header="Darstellung">
                <DockPanel Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                    <Button DockPanel.Dock="Bottom"
                            Content="Speichern und Schließen"
                            ToolTip="Speichere alle Änderungen"
                            Click="SaveAndClose_Click"
                            Margin="10,10,10,10"
                            HorizontalAlignment="Right">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Center"
                                                                Kind="ContentSave" />
                                    <TextBlock Margin="4 0 0 0"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20"
                                    HorizontalAlignment="Center"
                                    MaxWidth="700">
                            <Label Content="Erscheinungsbild"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,10"
                                   FontSize="26"
                                   FontWeight="Bold" />
                            <TextBlock TextWrapping="Wrap"
                                       FontSize="14"
                                       Margin="0,0,0,20"
                                       TextAlignment="Center"
                                       Text="Wähle das Farbschema der Anwendung. &quot;Systemstandard&quot; folgt automatisch der Windows-Einstellung." />

                            <Border Style="{StaticResource Modern.Card}"
                                    Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,4">
                                        <iconPacks:PackIconMaterial Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,10,0"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                                                    Kind="ThemeLightDark" />
                                        <Label Content="Farbschema:"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                        <ComboBox x:Name="ThemeComboBox"
                                                  MinWidth="240"
                                                  FontSize="16"
                                                  ItemsSource="{Binding Source={my:Enumeration {x:Type svc:ThemePreference}}}"
                                                  DisplayMemberPath="Description"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ThemeService.Preference, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

    </Grid>
</Window>